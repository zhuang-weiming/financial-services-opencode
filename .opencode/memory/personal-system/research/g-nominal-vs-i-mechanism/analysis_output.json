  "part_3_mechanism_verification": {
    "period": "1946-74",
    "old_narrative_test": {
      "claim": "金融抑制 = 实际利率负 + 通胀稀释",
      "actual_real_rate": "+1.70%",
      "verdict": "❌ FALSIFIED (实际利率为正, 不是负)",
      "explanation": "Creditors earned +1.70% real returns, NOT lost purchasing power."
    },
    "new_narrative_test": {
      "claim": "g_nominal > i → 分母稀释",
      "data": {
        "i": "4.72%",
        "g_nominal": "7.02%",
        "i - g_nominal": "-2.30pp"
      },
      "verdict": "✅ CONFIRMED",
      "explanation": "Nominal GDP (7%) grew faster than debt (4.72%) → Debt/GDP auto-fell."
    },
    "key_insight": "**1946-74 的真正杠杆是真实 GDP 高速增长**（g_real = 4%, 婴儿潮 + 战后重建）。\n**不是**「金融抑制」（实际利率为正 +1.70%）。\n**通胀只是辅助**（π = 3%），**真正驱动是 g_real**。"
  },
