{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "wealth-guide",
  "instructions": [
    ".opencode/instructions/data-priority.md",
    ".opencode/instructions/quant-research.md",
    ".opencode/instructions/wealth-guide-router.md",
    ".opencode/instructions/backtest-discipline.md",
    ".opencode/instructions/memory-protocol.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "morningstar": {
      "type": "remote",
      "url": "https://mcp.morningstar.com/mcp",
      "enabled": true
    },
    "ddg-search": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "vibe-trading": {
      "type": "local",
      "command": [
        "vibe-trading-mcp"
      ],
      "enabled": true,
      "_comment": "Vibe-Trading v0.1.15 MCP server — 74 tools. Install via 'pip install vibe-trading-ai'. See .opencode/skills/vibe-trading-alpha-zoo and .opencode/skills/vibe-trading-data-routing for the vendored Python engine."
    }
  },
  "agent": {
